# 黑盒测试凭据模板：复制为 agent/tools/.env.blackbox 并填写（该文件已被 gitignore）
# 原则：写操作只进 paper；real 仅用于只读冒烟。

# —— 模拟盘（paperMoney）——
TOS_PAPER_ACCESS_TOKEN=
TOS_PAPER_REFRESH_TOKEN=
TOS_PAPER_ACCOUNT=

# —— 真实账户（只读冒烟专用）——
TOS_REAL_ACCESS_TOKEN=
TOS_REAL_REFRESH_TOKEN=
TOS_REAL_ACCOUNT=

# —— 运行模式闸门：paper | real（safety.mjs 强制校验）——
TOS_ENV=paper
