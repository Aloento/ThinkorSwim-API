{
  "name": "tos-wsjson-client",
  "version": "0.13.0",
  "description": "WebSocket client for the Thinkorswim wsjson websocket API",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "bundle": "pnpm build && esbuild dist/index.js --bundle --outfile=dist/app.bundle.js --minify --sourcemap --platform=browser --target=es2022",
    "check_prettier": "prettier --check .",
    "lint": "eslint .",
    "test": "jest",
    "ci": "pnpm check_prettier && pnpm build && pnpm lint && pnpm test"
  },
  "dependencies": {
    "debug": "^4.4.3",
    "fast-json-patch": "^3.1.1",
    "isomorphic-ws": "^5.0.0",
    "obgen": "^0.5.2",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@swc/jest": "^0.2.39",
    "@types/debug": "^4.1.13",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "dotenv": "^18.0.7",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-jest": "^29.17.0",
    "jest": "^30.5.2",
    "jest-websocket-mock": "^2.5.0",
    "prettier": "^3.9.10",
    "puppeteer": "^25.13.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.2"
  },
  "packageManager": "pnpm@12.11.2"
}
