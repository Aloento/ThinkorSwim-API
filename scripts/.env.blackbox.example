# 黑盒测试凭据模板：复制为 scripts/.env.blackbox 并填写（该文件已被 gitignore）。
# 原则：写操作只进 paper；real 仅用于只读冒烟。
# 认证类键由 auth-guest.mjs / auth-real.mjs 登录后自动写入，无需手填 token。

# —— guestpass 模拟盘：auth-guest.mjs 的输入（或命令行传参覆盖）——
TOS_GUEST_USER=
TOS_GUEST_PASS=
# —— 以下由 auth-guest.mjs 登录后自动写入 ——
TOS_GUEST_ACCESS_TOKEN=
TOS_GUEST_WS_URL=
TOS_GUEST_CLIENT_ID=
TOS_GUEST_TRADING_SYSTEM=
TOS_GUEST_TOKEN_SAVED_AT=

# —— 真实账户：auth-real.mjs 的输入——
TOS_REAL_USER=
TOS_REAL_PASS=
# —— 以下由 auth-real.mjs / exp-auth-refresh.mjs 自动写入 ——
TOS_REAL_ACCESS_TOKEN=
TOS_REAL_REFRESH_TOKEN=
TOS_REAL_EAT_ACCESS_TOKEN=
TOS_REAL_WS_URL=
TOS_REAL_TRADING_SYSTEM=
TOS_REAL_TOKEN_SAVED_AT=

# —— 可选：纸面账户代码（不填则 smoke/probe 登录后从 accounts 服务现取 D- 开头项）——
TOS_PAPER_ACCOUNT=
